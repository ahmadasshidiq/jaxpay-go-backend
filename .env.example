APP_PORT=8080
POSTGRES_DSN_DEV="host=localhost user=postgres password=postgres dbname=jaxpay_db port=5432 sslmode=disable TimeZone=Asia/Jakarta"
JWT_SECRET=change-me
# Kunci AES untuk mengenkripsi api_secret & webhook_secret client di DB
ENCRYPTION_KEY=change-me-too
REDIS_URL=
RATE_LIMIT_PER_MINUTE=120

ESPAY_BASE_URL=https://sandbox-api.espay.id
ESPAY_PARTNER_ID=
ESPAY_MERCHANT_ID=
ESPAY_CHANNEL_ID=
# Private key merchant (menandatangani request) & public key Espay (validasi callback)
ESPAY_PRIVATE_KEY_PATH=./keys/espay_merchant_private.pem
ESPAY_PUBLIC_KEY_PATH=./keys/espay_public.pem
