# development | production (production menonaktifkan /docs)
APP_ENV=development
APP_PORT=8080
POSTGRES_DSN_DEV="host=localhost user=postgres password=postgres dbname=jaxpay_db port=5432 sslmode=disable TimeZone=Asia/Jakarta"
JWT_SECRET=change-me
# Kunci AES untuk mengenkripsi api_secret & webhook_secret client di DB
ENCRYPTION_KEY=change-me-too
REDIS_URL=
RATE_LIMIT_PER_MINUTE=120

ESPAY_BASE_URL=https://sandbox-api.espay.id
ESPAY_PARTNER_ID=
ESPAY_MERCHANT_ID=
ESPAY_CHANNEL_ID=
# Private key merchant (menandatangani request) & public key Espay (validasi callback)
ESPAY_PRIVATE_KEY_PATH=./keys/private.pem
ESPAY_PUBLIC_KEY_PATH=./keys/public.pem
ESPAY_PASSWORD=
ESPAY_SIGNATURE_KEY=
# API merchant (VA sendinvoice & status). Kosong = ESPAY_BASE_URL. Production: https://api-merchant.espay.id
ESPAY_MERCHANTPG_URL=

# CORS (comma-separated). Origins default "*"; extra headers are appended to the defaults.
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET, POST, PUT, PATCH, DELETE, OPTIONS
CORS_EXTRA_HEADERS=X-EXTERNAL-ID, X-PARTNER-ID, CHANNEL-ID, Authorization-Customer
